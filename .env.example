# Copy to .env.local for local work. On Vercel, add these in Project -> Settings -> Environment Variables.

# ---- Required ----
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543). No ?sslmode=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
CRON_SECRET=
# The public address of the website, with no slash at the end, e.g. https://zemba.shop
NEXT_PUBLIC_SITE_URL=https://zemba.shop
# true = the pay button is a pretend one (for testing only). Leave it out (or false) for the public.
ALLOW_DEMO_PAYMENTS=
# Set to true when real payments are working. It hides the "test mode / payments opening soon" bar.
PAYMENTS_LIVE=

# ---- Email (password reset, email confirmation, order alerts) ----
# Brevo: free, 300 emails/day. Settings -> SMTP & API -> API Keys, and verify your sender address under Senders.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Zemba Marketplace
# Where "the website broke" alerts and Contact-page messages are emailed
ADMIN_ALERT_EMAIL=

# ---- Google Search Console (optional): the code from the "HTML tag" verification method ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Payment provider (leave empty until you have signed an agreement) ----
# none (default) | demo (fake payments, Preview only) | lipila | lenco
PAYMENT_PROVIDER=
# the secret the provider uses to sign its webhook calls (from the provider's dashboard)
PAYMENT_WEBHOOK_SECRET=
# the provider's own keys. Use the one for your provider; the sandbox ones first, in Preview only
LIPILA_API_KEY=
LIPILA_BASE_URL=
LENCO_API_KEY=
LENCO_BASE_URL=
# true = the daily job sends due payouts and refunds by itself through the provider (default: you send them by hand)
AUTO_PAYOUTS=false
