# Copy to .env.local for local work. On Vercel, add these in Project -> Settings -> Environment Variables.

# ---- Required ----
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543). No ?sslmode=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=
ALLOW_DEMO_PAYMENTS=true

# ---- Email (password reset, email confirmation, order alerts) ----
# Brevo: free, 300 emails/day. Settings -> SMTP & API -> API Keys, and verify your sender address under Senders.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Zemba Marketplace
# Where "the website broke" alerts and Contact-page messages are emailed
ADMIN_ALERT_EMAIL=

# ---- SMS (optional, Africa's Talking) ----
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Google Search Console (optional): the code from the "HTML tag" verification method ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Payment gateway (later) ----
WEBHOOK_SECRET=
